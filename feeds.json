{
  "defaults": {
    "webhookEnv": "DISCORD_WEBHOOK",
    "maxPerRun": 5,
    "seenCap": 500,
    "descriptionChars": 400,
    "showImage": false,
    "username": "Feeds"
  },
  "feeds": [
    {
      "id": "apple-newsroom",
      "name": "Apple Newsroom",
      "url": "https://www.apple.com/ca/newsroom/rss-feed.rss",
      "webhookEnv": "DISCORD_WEBHOOK_APPLE_NEWSROOM",
      "username": "Apple Newsroom",
      "color": "#333333",
      "maxPerRun": 5,
      "descriptionChars": 4096,
      "showAuthor": false,
      "notify": [
        {
          "roles": ["1539011756297555998"],
          "text": "New hardware:",
          "when": {
            "fields": ["title", "summary"],
            "include": ["\\biphone\\b", "\\bmac(book)?\\b", "\\bipad\\b", "\\bvision pro\\b", "\\bapple watch\\b", "\\bairpods\\b", "\\bapple tv\\b.*\\b(4k|device|hardware|box)\\b|\\b(4k|device|hardware|box)\\b.*\\bapple tv\\b", "\\bhomepod\\b"]
          }
        }
      ]
    },
    {
      "id": "apple-dev-news",
      "name": "Apple Developer",
      "url": "https://developer.apple.com/news/rss/news.rss",
      "webhookEnv": "DISCORD_WEBHOOK_APPLE_DEV_NEWS",
      "username": "Apple Dev News",
      "color": "#0071e3",
      "maxPerRun": 10,
      "descriptionChars": 4096,
      "notify": [
        {
          "roles": ["1539012206782455868"],
          "text": "Attention:",
          "when": {
            "fields": ["title", "summary"],
            "include": ["\\bdeadline\\b", "\\brequir(e|ed|ement|ements)\\b", "\\bdeprecat\\w*", "\\bsubmissions?\\b", "\\bno longer\\b", "\\bchang(e|es|ed|ing)\\b", "\\baler(t|ts|ted|ting)\\b", "\\bupdat(e|es|ed)\\b", "\\bvuln\\b", "\\bcritical\\b", "\\bimportant\\b", "\\bsecurity\\b", "\\bfi(x|xes|xed|xing)\\b", "\\bbu(gs|gfi(x|xes))\\b", "\\bissu(e|es|ed)\\b", "\\boutag(e|es)\\b"]
          }
        },
        {
          "roles": ["1539012206782455868"],
          "text": "New event:",
          "when": {
            "fields": ["title", "summary"],
            "include": ["\\bApple Event\\b", "\\bWWDC\\b"]
          }
        }
      ]
    },
    {
      "id": "apple-releases",
      "name": "Apple Releases",
      "url": "https://developer.apple.com/news/releases/rss/releases.rss",
      "webhookEnv": "DISCORD_WEBHOOK_APPLE_RELEASES",
      "username": "Apple Releases",
      "color": "#34c759",
      "maxPerRun": 15,
      "descriptionChars": 300,
      "showDescription": false,
      "filters": {
        "fields": ["title"],
        "include": ["\\w*OS\\b|AirPods"],
        "exclude": ["\\bbetas?\\b", "\\brelease candidate\\b", "\\brc\\b", "\\bpreview\\b", "\\bseed\\b"]
      },
      "notify": [
        {
          "roles": ["1539012329553797182"],
          "text": "Public release:"
        }
      ]
    },
    {
      "id": "apple-releases-beta",
      "name": "Apple Releases — Betas",
      "url": "https://developer.apple.com/news/releases/rss/releases.rss",
      "webhookEnv": "DISCORD_WEBHOOK_APPLE_RELEASES_BETA",
      "username": "Apple Releases (beta)",
      "color": "#ff9f0a",
      "maxPerRun": 20,
      "descriptionChars": 300,
      "showDescription": false,
      "filters": {
        "fields": ["title"],
        "include": ["(\\w*OS|AirPods).*(\\bbetas?\\b|\\brelease candidate\\b|\\brc\\b|\\bpreview\\b|\\bseed\\b)|(\\bbetas?\\b|\\brelease candidate\\b|\\brc\\b|\\bpreview\\b|\\bseed\\b).*(\\w*OS|AirPods)"]
      },
      "notify": [
        {
          "roles": ["1539012420125593620"],
          "text": "Beta release:"
        }
      ]
    },
    {
      "id": "nfl-news",
      "name": "NFL News",
      "url": "https://www.espn.com/espn/rss/nfl/news",
      "webhookEnv": "DISCORD_WEBHOOK_NFL_NEWS",
      "username": "NFL News",
      "color": "#0B2265",
      "maxPerRun": 20,
      "descriptionChars": 4096,
      "showDescription": false,
      "filters": {
        "fields": ["title"],
        "exclude": ["\\bbe(t|ts|tting)?\\b"]
      },
      "notify": [
        {
          "roles": ["1542330701066801203"],
          "text": "League news:",
          "when": {
            "fields": ["title", "summary"],
            "exclude": [ "\\b49ers\\b", "\\bBears\\b", "\\bBengals\\b", "\\bBills\\b", "\\bBroncos\\b", "\\bBrowns\\b", "\\bBuccaneers\\b", "\\bCardinals\\b", "\\bChargers\\b", "\\bChiefs\\b", "\\bColts\\b", "\\bCommanders\\b", "\\bCowboys\\b", "\\bDolphins\\b", "\\bEagles\\b", "\\bFalcons\\b", "\\bGiants\\b", "\\bJaguars\\b", "\\bJets\\b", "\\bLions\\b", "\\bPackers\\b", "\\bPanthers\\b", "\\bPatriots\\b", "\\bRaiders\\b", "\\bRams\\b", "\\bRavens\\b", "\\bSaints\\b", "\\bSeahawks\\b", "\\bSteelers\\b", "\\bTexans\\b", "\\bTitans\\b", "\\bVikings?\\b"]
          }
        },
        {
          "roles": ["1542335085280235632"],
          "text": "Browns news:",
          "when": {
            "fields": ["title", "summary"],
            "include": ["\\bBrowns\\b"]
          }
        },
        {
          "roles": ["1542334746942644274"],
          "text": "Giants news:",
          "when": {
            "fields": ["title", "summary"],
            "include": ["\\bGiants\\b"]
          }
        },
        {
          "roles": ["1542337543260086382"],
          "text": "Lions news:",
          "when": {
            "fields": ["title", "summary"],
            "include": ["\\bLions\\b"]
          }
        }
      ]
    }
  ]
}
